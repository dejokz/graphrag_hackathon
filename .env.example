# TigerGraph GraphRAG Hackathon Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git

# ============================
# LLM Provider Configuration
# ============================

# Google Gemini API Key (for both embeddings and completion)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ============================
# TigerGraph Database Configuration
# ============================

# TigerGraph Savanna Hostname
# Example: https://your-instance.i.tgcloud.io
TIGERGRAPH_HOSTNAME=your_tigergraph_hostname_here

# TigerGraph Connection Ports
TIGERGRAPH_RESTPP_PORT=443
TIGERGRAPH_GS_PORT=443
TIGERGRAPH_API_TOKEN_NEW=your_tigergraph_api_token_here

# TigerGraph Authentication (if token-based auth is enabled)
# TIGERGRAPH_USERNAME=tigergraph
# TIGERGRAPH_PASSWORD=tigergraph
# TIGERGRAPH_API_TOKEN=your_api_token_here

# ============================
# GraphRAG Service Configuration
# ============================

# GraphRAG ECC Service URL (usually runs in Docker)
GRAPHRAG_ECC_URL=http://graphrag-ecc:8001

# Chat History Service URL (usually runs in Docker)
CHAT_HISTORY_API_URL=http://chat-history:8002

# ============================
# Optional: Performance Tuning
# ============================

# Default query timeout in seconds
DEFAULT_TIMEOUT=300

# Memory threshold in MB for query execution
DEFAULT_MEM_THRESHOLD=5000

# Max threads for query execution
DEFAULT_THREAD_LIMIT=8

# ============================
# Optional: LLM Model Configuration
# ============================

# Embedding model (default: models/text-embedding-004)
# EMBEDDING_MODEL=models/text-embedding-004

# Completion model (default: gemini-2.0-flash)
# COMPLETION_MODEL=gemini-2.0-flash

# Token limit for context (default: 4096)
# TOKEN_LIMIT=4096