{
  "evaluation_settings": {
    "llm_judge_model": "gemini-2.5-flash",
    "bertscore_model": "bert-base-uncased",
    "batch_size": 5,
    "timeout_seconds": 300
  },
  "pipeline_tuning": {
    "llm_only": {
      "model": "gemini-2.5-flash",
      "temperature": 0
    },
    "basic_rag": {
      "model": "gemini-2.5-flash",
      "temperature": 0,
      "top_k": 5,
      "method": "similarity"
    },
    "graphrag": {
      "method": "hybrid",
      "top_k": 3,
      "num_hops": 2,
      "num_seen_min": 1,
      "similarity_threshold": 0.85,
      "chunk_only": true,
      "combine": true,
      "community_level": 2
    }
  },
  "bonus_thresholds": {
    "llm_judge_pass_rate": 90.0,
    "bertscore_f1_raw": 0.88,
    "bertscore_f1_rescaled": 0.55
  },
  "competition_requirements": {
    "target_token_reduction_vs_rag": 40.0,
    "min_tokens": 1000000
  }
}